<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShopMate._2._0.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShopMate._2._0.Presentation.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="ShopMate._2._0"
    BackgroundColor="#303030"
    TitleColor="White"
    Shell.TabBarTitleColor="#47f267" 
    Shell.TabBarUnselectedColor="#dadada"
   
    Shell.TabBarForegroundColor="#47f267"
   
    Shell.TabBarBackgroundColor="#434343"
    >

    <TabBar>
        <ShellContent Title="Recipe"
                      Icon="recipe_book.png"
                      ContentTemplate="{DataTemplate views:RecipePage}" />
        <ShellContent Title="Cart"
                      Icon="shopping_cart.png"
                      ContentTemplate="{DataTemplate views:CartPage}" />
        <ShellContent Title="Location"
                      Icon="location.png"
                      ContentTemplate="{DataTemplate views:LocationPage}" />
    </TabBar>
</Shell>
