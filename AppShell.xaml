<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShopMate._2._0.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:recipe="clr-namespace:ShopMate._2._0.Presentation.Views.RecipeView"
    xmlns:cart="clr-namespace:ShopMate._2._0.Presentation.Views.CartView"
    xmlns:location="clr-namespace:ShopMate._2._0.Presentation.Views"
    Title="ShopMate._2._0"
    BackgroundColor="White"
    TitleColor="Black"
    Shell.NavBarHasShadow="True"
    Shell.TabBarTitleColor="#26e01f" 
    Shell.TabBarUnselectedColor="#8a8a8a"
    Shell.TabBarForegroundColor="#26e01f"
   
    Shell.TabBarBackgroundColor="White" 
    >
    
            <TabBar>
                <ShellContent Title="Recipes"
                              Icon="recipe_book.png"
                              ContentTemplate="{DataTemplate recipe:RecipePage}" />
                <ShellContent Title="Cart"
                              Icon="shopping_cart.png"
                              ContentTemplate="{DataTemplate cart:CartPage}" />
                <ShellContent Title="Location"
                              Icon="location.png"
                              ContentTemplate="{DataTemplate location:LocationPage}" />
            </TabBar>
       
</Shell>
