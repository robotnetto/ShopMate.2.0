<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopMate._2._0.Presentation.Views.RecipeView.RecipeDescription"
             Title="{Binding SelectedRecipe.Title}"
           
             Background="#FAFAF9"
             >
    <ContentPage.ToolbarItems>
        <ToolbarItem 
          
                Text="Add"
                
                IconImageSource="add_photo.png" 
                
                Command="{Binding LoadImageCommand}" />
    </ContentPage.ToolbarItems>


    <StackLayout Padding="3,0,3,0">
        <!--<Frame Margin="0,0,0,10"
       HasShadow="True"
       CornerRadius="100"
       HeightRequest="130"
       WidthRequest="130"
       IsClippedToBounds="True"
       HorizontalOptions="Center"
       VerticalOptions="Center">
            <Image Source="{Binding SelectedRecipe.ImageStream}"
        
         Aspect="AspectFill"
         HeightRequest="100"
         WidthRequest="250"/>
        </Frame>-->
        <Border Margin="0,0,0,0
                
                
                " StrokeShape="RoundRectangle 20,20,20,20"
               
                HorizontalOptions="Center">
            <Border.Shadow>
                <Shadow Offset="1,1" Brush="Black" Opacity="0.5" />
            </Border.Shadow>
            <Image Source="{Binding SelectedRecipe.ImageStream}"
        
         Aspect="AspectFill"
         HeightRequest="200"
         WidthRequest="450"/>
        </Border>

        <Frame x:Name="titleFrame" BackgroundColor="White" CornerRadius="13" Padding="0,8,0,0" HasShadow="True">


            <Editor Text="{Binding SelectedRecipe.Description}"
               Placeholder="Your recipe here..." 
               AutoSize="TextChanges" 
               FontSize="15"
               Margin="10,0,10,0"
               Background="White"
               BackgroundColor="Gray"
               TextColor="Black"
               VerticalOptions="StartAndExpand"
               TextChanged="Editor_TextChanged"
               MinimumHeightRequest="100" />
            <!-- Adjust this value based on the desired number of lines -->
        </Frame>



    </StackLayout>

</ContentPage>