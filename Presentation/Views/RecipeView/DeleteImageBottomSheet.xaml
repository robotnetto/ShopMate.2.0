<?xml version="1.0" encoding="utf-8" ?>
<the49:BottomSheet xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="ShopMate._2._0.Presentation.Views.RecipeView.DeleteImageBottomSheet"
                   xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
                   xmlns:local="clr-namespace:ShopMate._2._0.Presentation.CostumConvert"
                   BackgroundColor="White"
                   CornerRadius="10"
                   IsCancelable="True"
                   HasBackdrop="True"
                   HasHandle="False" >    


    <the49:BottomSheet.Resources>
        <ResourceDictionary>
            <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
        </ResourceDictionary>
    </the49:BottomSheet.Resources>

    <VerticalStackLayout Padding="20,20,20,10">
        <Grid Margin="0,0,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label 
              Text="Manage Item"
              FontSize="20"
              FontAttributes="Bold"
              TextColor="Black"
              VerticalOptions="Center"
              Grid.Column="0" />
            <ImageButton 
              Source="close_filled.png"
              BackgroundColor="Transparent"
              WidthRequest="24"
              HeightRequest="24"
              Command="{Binding CloseCommand}"
              Grid.Column="1" />
        </Grid>

        <VerticalStackLayout>
           
            <HorizontalStackLayout Spacing="3">
                <Image Source="delete.png" HeightRequest="25" WidthRequest="25" />
                <Button Text="Delete Image" 
                         Padding="14,10,200,10"
                        BackgroundColor="Transparent" 
                        FontSize="14" TextColor="Red" 
                        FontAttributes="Bold"
                        Command="{Binding DeleteImageCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</the49:BottomSheet>
