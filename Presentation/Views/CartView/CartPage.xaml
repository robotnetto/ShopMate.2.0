<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:ShopMate._2._0.Domain.Entities"
             x:Class="ShopMate._2._0.Presentation.Views.CartView.CartPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:local ="clr-namespace:ShopMate._2._0.Presentation.CostumConvert"
             Title="My List"
              Background="#f5f5f5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"
                     IconImageSource="add_filled.png"
                     Command="{Binding AddCartCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
     
    <Grid>
        <CollectionView ItemsSource="{Binding Carts}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Cart">
                    <VerticalStackLayout>
                        <Frame Margin="15,10,15,7" Padding="0,0,15,0" Background="White" BorderColor="White" HasShadow="True">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Opacity="0.1" Offset="8,8" Radius="10" />
                            </Frame.Shadow>
                            
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CardSelectCommand}" 
                                        CommandParameter="{Binding .}" 
                                        NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                              

                                <Label Grid.Column="1" Padding="20,0,0,0" VerticalOptions="Center" TextColor="Black" Text="{Binding Title}" FontAttributes="Bold" FontSize="Medium"/>

                                <ImageButton Grid.Column="2" VerticalOptions="Center" HeightRequest="25" WidthRequest="25" Margin="0,27,0,27" Source="options_v3.png"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OptionsCommand}" 
                                             CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout VerticalOptions="Center" Margin="0,0,0,200">
            <skia:SKLottieView Source="grocery.json" 
                               RepeatCount="-1"
                               RepeatMode="Restart"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               HeightRequest="250"
                               WidthRequest="250"
                               IsVisible="{Binding Carts.Count, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Label Text="Let's create your shoppoing " 
                   FontSize="16"
                   TextColor="Gray"
                   FontAttributes="Bold"
                   Margin="0,-20,0,0" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   IsVisible="{Binding Carts.Count, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>