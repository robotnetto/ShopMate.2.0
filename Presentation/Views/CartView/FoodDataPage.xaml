<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopMate._2._0.Presentation.Views.CartView.FoodDataPage"
             Title="Add New Item"
             xmlns:local="clr-namespace:ShopMate._2._0.Presentation.CostumConvert"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="White"
             Shell.TabBarIsVisible="False">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
        </Grid.GestureRecognizers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header with Label & Close Button -->
            <RowDefinition Height="Auto" />
            <!-- Search Box -->
            <RowDefinition Height="*" />
            <!-- Remaining Content -->
        </Grid.RowDefinitions>

        <!-- Header Grid (Title + Close Button + Search Box) -->
        <Grid Grid.Row="0" BackgroundColor="#68befc" Padding="10,10,10,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Label + Close Button -->
                <RowDefinition Height="Auto" />
                <!-- Search Box -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Label takes most space -->
                <ColumnDefinition Width="Auto" />
                <!-- Close button stays small -->
            </Grid.ColumnDefinitions>

            <!-- Title Label -->
            <Label Text="New Items"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"
               VerticalOptions="Center"
               HorizontalOptions="Start"
               
               Grid.Row="0"
               Grid.Column="0" />

            <!-- Close Button -->
            <ImageButton Source="close_filled.png"
                     BackgroundColor="Transparent"
                     WidthRequest="28"
                     HeightRequest="30"
                     Command="{Binding CloseCommand}"
                     HorizontalOptions="End"
                     VerticalOptions="Center"
                    
                     Grid.Row="0"
                     Grid.Column="1"/>

            <!-- Search Box Inside Header Grid -->
            <Frame x:Name="searchFrame"
               BackgroundColor="White"
               CornerRadius="13"
               Padding="2"
               Margin="0,10,0,0"
               HasShadow="False"
               Grid.Row="1"
               Grid.ColumnSpan="2">
                <Frame.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Offset="8,8" Radius="10" />
                </Frame.Shadow>
                <Entry x:Name="searchItemEntry"
                   TextChanged="Search_TextChanged"
                   Text="{Binding SearchText}"
                   Placeholder="Search items"
                   PlaceholderColor="Gray"
                   TextColor="Black"
                   VerticalOptions="Center"
                   HorizontalOptions="FillAndExpand"
                   FontSize="16"
                   Margin="0"
                   HeightRequest="40"/>
            </Frame>
        </Grid>
   

    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,50,0,0"  VerticalOptions="Center" HorizontalOptions="Center"/>

        <CollectionView x:Name="ItemsCollectionView"
                     Grid.Row="2"
             ItemsSource="{Binding FoodDataItems}"
             RemainingItemsThreshold="5"
             RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
                     Scrolled="ItemsCollectionView_Scrolled"
             Grid.ColumnSpan="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid >

                        <VerticalStackLayout Padding="5">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemSelectedCommand}"
                                               CommandParameter="{Binding .}"
                                               NumberOfTapsRequired="1"/>
                            </VerticalStackLayout.GestureRecognizers>
                            <!--<VerticalStackLayout.Triggers>
                             <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsSelected}" Value="True">
                                 <Setter Property="BackgroundColor" Value="LightGreen" />
                             </DataTrigger>
                         </VerticalStackLayout.Triggers>-->

                            <StackLayout Orientation="Horizontal" Padding="10">
                                <Label Text="{Binding Name}" VerticalOptions="Center" HorizontalOptions="Start" LineBreakMode="WordWrap" MaxLines="2" WidthRequest="300"/>
                            </StackLayout>

                            <BoxView HeightRequest="1" Color="Gray" Margin="10,0" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>