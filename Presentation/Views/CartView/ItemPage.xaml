<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopMate._2._0.Presentation.Views.CartView.ItemPage"
             Title="{Binding SelectedCart.Title}"
             Background="#f5f5f5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"
                     IconImageSource="add_filled.png"
                     Command="{Binding AddItemComand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding SelectedCart.Items}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <!-- Item Layout -->
                    <StackLayout Orientation="Horizontal" Padding="10">
                        <CheckBox IsChecked="{Binding IsChecked}" Color="Green" />
                        <Label Text="{Binding ItemName}" VerticalOptions="Center" HorizontalOptions="Start" />
                    </StackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="Gray" Margin="10,0" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>