<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopMate._2._0.Presentation.Views.SplashView.SplashPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             Title="SplashPage"
             BackgroundColor="White">

    <VerticalStackLayout VerticalOptions="Center" Margin="0,0,0,150">
        <skia:SKLottieView Source="loadingcart.json" 
                        RepeatCount="-1"
                        RepeatMode="Restart"
                        HorizontalOptions="Center" 
                        VerticalOptions="Center"
                        HeightRequest="200"
                        WidthRequest="200"
                       />
        <Label HorizontalOptions="Center" 
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding IsLoading}"
               Margin="0,10,0,0" >
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="First-time setup may take longer to laod" />
                    <Span Text="&#10;" />
                    <Span Text="Hang tight!" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </VerticalStackLayout>
</ContentPage>