<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ShopMate._2._0.Presentation.Views.BottomSheet"
             BackgroundColor="Transparent">

    <Grid RowDefinitions="*,Auto">
        <BoxView Color="Transparent" Grid.Row="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseBottomSheetCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <VerticalStackLayout Grid.Row="1" Padding="20" BackgroundColor="White" VerticalOptions="EndAndExpand">
            <Label Text="Options" FontAttributes="Bold" FontSize="Large" HorizontalOptions="Center" />
            <Button Text="Edit" Command="{Binding EditRecipeCommand}" CommandParameter="{Binding SelectedRecipe}" />
            <Button Text="Delete" Command="{Binding DeleteRecipeCommand}" CommandParameter="{Binding SelectedRecipe}" />
            <Button Text="Cancel" Command="{Binding CloseBottomSheetCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
